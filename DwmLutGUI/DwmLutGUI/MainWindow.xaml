<Window x:Class="DwmLutGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DwmLutGUI"
        mc:Ignorable="d"
        Title="ScreenFilterDWM GUI" Height="365" Width="600" MinHeight="200" MinWidth="300">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <DockPanel>
        <StatusBar DockPanel.Dock="bottom">
            <TextBlock Text="{Binding ActiveText, StringFormat=Status: {0}}" />
        </StatusBar>
        <DockPanel Margin="6">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,0,6" Text="Colors" TextAlignment="Right" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Palette" TextAlignment="Right" />
                <ComboBox x:Name="ToggleKeyCombo" Grid.Row="2" Grid.Column="0" Text="Toggle Key" SelectedItem="{Binding ToggleKey}" />
                <ComboBox x:Name="ColorCombo" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="373" Height="22" Margin="6,0,0,4" SelectedIndex="3">
                    <ComboBoxItem Content="True Color (32-bit)"/>
                    <ComboBoxItem Content="High Color (16-bit)"/>
                    <ComboBoxItem Content="High Color (15-bit)"/>
                    <ComboBoxItem Content="256 Colors"/>
                    <ComboBoxItem Content="64 Colors"/>
                    <ComboBoxItem Content="20 Colors"/>
                    <ComboBoxItem Content="16 Colors"/>
                    <ComboBoxItem Content="8 Colors"/>
                    <ComboBoxItem Content="4 Colors"/>
                    <ComboBoxItem Content="Monochrome"/>
                </ComboBox>
                <ComboBox x:Name="PalCombo" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Width="373" Height="22" Margin="6,0,0,0" Grid.Row="1" SelectedIndex="0">
                    <ComboBoxItem Content="Default"/>
                    <ComboBoxItem Content="Grayscale"/>
                    <ComboBoxItem Content="EGA (16) / UltraVNC Dark (8) / Custom Color (Mono)"/>
                    <ComboBoxItem Content="VGA Alt (16)"/>
                </ComboBox>
                <CheckBox x:Name="Dither" Grid.Column="1" Content="Dither" HorizontalAlignment="Left" Margin="385,0,0,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="Invert" Grid.Column="1" Content="Invert" HorizontalAlignment="Left" Margin="438,0,0,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="NoPal" Grid.Column="1" Content="Don't use palette" HorizontalAlignment="Left" Margin="385,0,0,0" VerticalAlignment="Center" Grid.Row="1"/>
                <Button Grid.Column="1" Content="Set Custom Monochrome Color" HorizontalAlignment="Right" Grid.Row="2" VerticalAlignment="Center" Width="191" Click="SetMonoColorButton_Click"/>
            </Grid>
            <Grid DockPanel.Dock="Bottom">
                <Button Content="About" Width="75" HorizontalAlignment="Left" Click="AboutButton_Click" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button IsEnabled="{Binding CanApply}" Content="Apply" Width="75" Margin="0,0,6,0"
                            Click="Apply_Click" />
                    <Button Content="Disable" Width="75" IsEnabled="{Binding IsActive}"
                            Click="Disable_Click" />
                </WrapPanel>
            </Grid>
            <DataGrid SelectedItem="{Binding SelectedMonitor}" ItemsSource="{Binding Monitors}" RowHeaderWidth="0"
                      IsReadOnly="{Binding IsActive}" AutoGenerateColumns="False" DockPanel.Dock="Bottom" Margin="0,0,0,6"
                      CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding SourceId}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Connector" Binding="{Binding Connector}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Position" Binding="{Binding Position}" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="SDR LUT" Width="*" IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SdrLutFilename, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding SdrLuts}" SelectedItem="{Binding SdrLutPath, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Button Content="-" Click="RemoveSdrLut_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                    </DataGridTemplateColumn>
                    <!-- <DataGridTextColumn Header="SDR LUT" Width="*" Binding="{Binding SdrLutFilename}" /> -->
                    <DataGridTemplateColumn Header="HDR LUT" Width="*" IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HdrLutFilename, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding HdrLuts}" SelectedItem="{Binding HdrLutPath, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Button Content="-" Click="RemoveHdrLut_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </DockPanel>
</Window>